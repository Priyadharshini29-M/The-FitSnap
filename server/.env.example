# Copy to server/.env and fill in. Never commit .env.

PORT=3000

# huggingface | runpod | mock   (mock = no GPU, returns the uploaded photo, for testing the one-try rule)
TRYON_PROVIDER=mock

# Long random string. Used to sign the visitor cookie and hash IPs before storing them.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Hugging Face (Gradio Space) ---
HF_TOKEN=
HF_SPACE=yisol/IDM-VTON
HF_STEPS=30

# --- RunPod serverless ---
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# names of the input fields your RunPod handler expects
RUNPOD_PERSON_FIELD=person_image
RUNPOD_GARMENT_FIELD=garment_image
# extra fixed inputs as JSON, e.g. {"steps":30,"seed":42}
RUNPOD_EXTRA_INPUT={}

# --- real visitor IPs ---
# Behind nginx / a load balancer set the number of proxy hops (usually 1). Leave empty when exposed directly.
TRUST_PROXY=
# If the site is behind Cloudflare, set true so the visitor IP is read from CF-Connecting-IP.
TRUST_CLOUDFLARE=false

# give up on a try-on after this many ms
TRYON_TIMEOUT_MS=150000
